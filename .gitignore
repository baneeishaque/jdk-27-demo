# Maven build output
target/

# Session-scoped scratch artifacts (probes, logs, intermediate captures)
scratch/

# Video production intermediates (large; regenerated by content/youtube/build-video.py)
content/youtube/build/
content/youtube/audio/*.aiff
content/youtube/audio/*.wav

# Node dependencies (Playwright only; used by the slide renderer)
node_modules/

# Benchmark scratch output (final measured reports live under benchmarks/results/)
benchmarks/scratch/

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*.local.json

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
